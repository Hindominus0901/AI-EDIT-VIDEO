{
  "name": "video-editor-kit",
  "version": "1.6.3",
  "description": "Local-first talking-head reel editor: STT -> silence cut -> EDL -> Remotion render",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "studio": "remotion studio",
    "studio:edl": "node scripts/make-render-props.mjs && remotion studio --props=out/edl-props.json",
    "render": "remotion render Reel out/reel.mp4",
    "render:edl": "node scripts/make-render-props.mjs && remotion render Reel out/final.mp4 --props=out/edl-props.json",
    "doctor": "python scripts/doctor.py",
    "motion:catalog": "remotion render MotionCatalog asset-library/motion-kit/motion-catalog.mp4 --concurrency=3 --crf=17 --x264-preset=fast --image-format=png",
    "typecheck": "tsc"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@remotion/captions": "4.0.475",
    "@remotion/cli": "4.0.475",
    "@remotion/google-fonts": "4.0.475",
    "@remotion/paths": "4.0.475",
    "@remotion/three": "4.0.475",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "4.0.475",
    "three": "^0.184.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "typescript": "^6.0.3"
  }
}
